{
  "database_name": "PET & Medicina Nuclear Prescripciones Clínicas",
  "version": "1.0.0",
  "compatible_with": "pet_ct_triage Suite & Google Sheets Tally",
  "description": "Base de datos clínica estructurada para peticiones médicas con interoperabilidad directa con el sistema de triaje nuclear",
  "fields": [
    { "name": "Submission ID", "type": "string", "example": "sub_70669892", "description": "Identificador único de la petición" },
    { "name": "Respondent ID", "type": "string", "example": "resp_52736221", "description": "Identificador del encuestador o terminal" },
    { "name": "Modalidad", "type": "string", "enum": ["PET", "CONVENCIONAL"], "description": "Modalidad de medicina nuclear" },
    { "name": "Fecha Solicitud", "type": "date (YYYY-MM-DD)", "example": "2026-10-10", "description": "Fecha de registro de la petición" },
    { "name": "NHC / Historia Clínica", "type": "string", "example": "NHC-131362", "description": "Número de historia clínica del paciente" },
    { "name": "Nombre del Paciente", "type": "string", "example": "Cristina Rodríguez Martín", "description": "Nombre y apellidos completos" },
    { "name": "Sexo", "type": "string", "enum": ["Masculino", "Femenino"], "description": "Sexo biológico del paciente" },
    { "name": "Edad", "type": "integer", "example": 65, "description": "Edad del paciente en años" },
    { "name": "Talla (cm)", "type": "number", "example": 154, "description": "Estatura en centímetros" },
    { "name": "Peso (kg)", "type": "number", "example": 75, "description": "Peso en kilogramos para dosimetría" },
    { "name": "Servicio Solicitante", "type": "string", "example": "Oncología", "description": "Especialidad médica prescriptora" },
    { "name": "Médico Solicitante", "type": "string", "example": "Dr. Carlos Rodríguez", "description": "Nombre del facultativo emisor" },
    { "name": "Diagnóstico Clínico", "type": "string", "example": "Linfoma de Hodgkin", "description": "Sospecha o patología confirmada" },
    { "name": "Motivo de Solicitud", "type": "string", "example": "Monitorización de Respuesta", "description": "Objetivo clínico del estudio" },
    { "name": "Tipo de Estudio PET Solicitado", "type": "string", "example": "FDG Oncológico / Inflamatorio", "enum": ["FDG Oncológico / Inflamatorio", "FDG con Contraste Iodado", "FDG con Endocarditis + Protocolo HEP", "68Ga-PSMA", "68Ga-DOTATOC Tumores Neuroendocrinos", "18F-Colina", "18F-Paratiroides", "FDG Neurológico Normal", "FDG Neurológico + Neurofisioneurología", "18F-PSMA"], "description": "Trazador o estudio PET seleccionado (10 pruebas clínicas oficiales)" },
    { "name": "Carácter de la Petición", "type": "string", "enum": ["Urgente", "Preferente", "Ordinaria", "Ordinario"], "description": "Prioridad prescripta" },
    { "name": "Prioridad Calculada", "type": "string", "enum": ["🔴 P1", "🟡 P2", "🟢 P3"], "description": "Prioridad calculada según algoritmo ALARA" },
    { "name": "Ventana Clínica (Días Laborables)", "type": "integer", "example": 14, "description": "Días objetivo para realización" },
    { "name": "Fecha Próxima Consulta", "type": "string", "example": "22/10/2026", "description": "Fecha de consulta médica o comité" },
    { "name": "Fecha Cita Asignada", "type": "string", "example": "2026-10-16", "description": "Fecha asignada en parrilla por triaje" },
    { "name": "Hora Cita Asignada", "type": "string", "example": "08:20 h (18F-FDG)", "description": "Hora y franja asignada" },
    { "name": "¿El paciente está ingresado?", "type": "string", "enum": ["No", "Sí"], "description": "Estado de hospitalización" },
    { "¿Precisa sedación?": "string", "enum": ["No", "Sí"], "description": "Necesidad de sedación / ansiolíticos" },
    { "Movilidad / Traslado": "string", "enum": ["Autónomo", "Movilidad reducida", "Encamado", "Silla de ruedas", "Cama"], "description": "Requerimientos de traslado" },
    { "¿Tiene Diabetes Mellitus?": "string", "enum": ["No", "Sí"], "description": "Diagnóstico de diabetes" },
    { "Glucemia (mg/dL)": "number", "example": 105, "description": "Nivel de glucemia basal" },
    { "Fin Tratamiento QT/RT": "string", "example": "2026-09-28", "description": "Fecha de fin de último ciclo" },
    { "Alergias Conocidas": "string", "example": "Penicilina", "description": "Alergias medicamentosas declaradas" },
    { "Alertas Técnicas": "string", "example": "Ninguna", "description": "Observaciones técnicas para radiofarmacia y cámara" },
    { "Estado de Triaje": "string", "enum": ["Pendiente de Triaje", "Cita Asignada", "Realizado"], "description": "Estado del flujo de trabajo" }
  ]
}
